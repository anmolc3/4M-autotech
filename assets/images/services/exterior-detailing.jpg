      <stop offset="0%" stop-color="#E6A817" stop-opacity="0.32" />
      <stop offset="55%" stop-color="#121212" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#060606" stop-opacity="1" />
    </radialGradient>
    <linearGradient id="accentLine_exterior-detailing" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#E6A817" stop-opacity="0" />
      <stop offset="50%" stop-color="#E6A817" stop-opacity="1" />
      <stop offset="100%" stop-color="#E6A817" stop-opacity="0" />
