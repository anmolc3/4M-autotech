      <circle cx="435" cy="215" r="8" fill="#e6a817"/>
    
  </g>

  <g text-anchor="middle">
    <text x="400" y="52" font-family="&apos;Rajdhani&apos;, &apos;Arial Black&apos;, sans-serif" font-size="14" font-weight="900" fill="#E6A817" letter-spacing="4">4M AUTOTECH • DETAILING STUDIO</text>
    
