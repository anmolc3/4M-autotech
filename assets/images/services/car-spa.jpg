<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <radialGradient id="servGrad_car-spa" cx="50%" cy="38%" r="70%">
      <stop offset="0%" stop-color="#D71920" stop-opacity="0.32" />
      <stop offset="55%" stop-color="#121212" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#060606" stop-opacity="1" />
    </radialGradient>
    <linearGradient id="accentLine_car-spa" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#D71920" stop-opacity="0" />
      <stop offset="50%" stop-color="#D71920" stop-opacity="1" />
      <stop offset="100%" stop-color="#D71920" stop-opacity="0" />
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#servGrad_car-spa)" />

  <g opacity="0.08" stroke="#ffffff" stroke-width="1.5" fill="none">
    <path d="M 80 340 L 220 340 Q 280 230 420 230 Q 560 230 640 280 L 720 340" />
    <circle cx="230" cy="340" r="45" />
    <circle cx="630" cy="340" r="45" />
    <line x1="0" y1="385" x2="800" y2="385" />
    <line x1="0" y1="65" x2="800" y2="65" />
    <line x1="200" y1="0" x2="200" y2="450" stroke-dasharray="4 6"/>
    <line x1="600" y1="0" x2="600" y2="450" stroke-dasharray="4 6"/>
  </g>

  <line x1="80" y1="380" x2="720" y2="380" stroke="url(#accentLine_car-spa)" stroke-width="3" />

  <g id="centerGraphic">
    
      <circle cx="400" cy="180" r="70" fill="#200a0a" stroke="#D71920" stroke-width="3.5" />
      <polygon points="400,120 415,155 452,155 422,177 433,212 400,190 367,212 378,177 348,155 385,155" fill="#E6A817" stroke="#ffffff" stroke-width="1.5"/>
      <circle cx="400" cy="180" r="86" fill="none" stroke="#E6A817" stroke-width="1.5" stroke-dasharray="6 4" />
    
  </g>

  <g text-anchor="middle">
    <text x="400" y="52" font-family="&apos;Rajdhani&apos;, &apos;Arial Black&apos;, sans-serif" font-size="14" font-weight="900" fill="#D71920" letter-spacing="4">4M AUTOTECH • DETAILING STUDIO</text>
    
    <text x="400" y="295" font-family="&apos;Rajdhani&apos;, &apos;Impact&apos;, sans-serif" font-size="30" font-weight="900" fill="#ffffff" letter-spacing="2">THE CAR SPA PACKAGE</text>
    
    <text x="400" y="322" font-family="&apos;Rajdhani&apos;, sans-serif" font-size="14" font-weight="800" fill="#D71920" letter-spacing="2.5">THE ULTIMATE 360° ALL-INCLUSIVE FULL DETAILING</text>
    
    <text x="400" y="348" font-family="&apos;Inter&apos;, sans-serif" font-size="12" font-weight="500" fill="#bbbbbb" letter-spacing="0.5">Exterior Polish • Interior Sanitization • Engine Bay • 9H Protection Seal</text>
    
    <rect x="310" y="398" width="180" height="24" rx="12" fill="#181818" stroke="#D71920" stroke-width="1.2" />
    <text x="400" y="414" font-family="&apos;Rajdhani&apos;, sans-serif" font-size="11" font-weight="800" fill="#ffffff" letter-spacing="2">100% QUALITY GUARANTEED</text>
  </g>
</svg>